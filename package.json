{
  "name": "retroflect",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && cross-env NODE_ENV=production react-router build",
    "dev": "prisma generate && cross-env NODE_ENV=development react-router dev",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "prisma generate && react-router typegen && tsc",
    "audit:check": "node scripts/audit-check.mjs"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@react-router/node": "7.18.5",
    "@supabase/supabase-js": "2.57.4",
    "isbot": "5.1.30",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.5",
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vercel/react-router": "1.3.7",
    "cross-env": "10.0.0",
    "prettier": "3.6.2",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.12",
    "typescript": "5.9.2",
    "vite": "6.4.5",
    "vite-tsconfig-paths": "5.1.4"
  }
}
