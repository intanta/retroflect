# Never run dependencies' install/postinstall scripts. They are the most common way
# malicious packages execute code. Packages that need a build step are handled
# explicitly in package.json scripts (e.g. `prisma generate`).
ignore-scripts=true

# Save exact versions (no ^ or ~), so package.json and the lockfile always agree on
# what is installed and every upgrade is an explicit, reviewable change (Dependabot PR).
save-exact=true

# Refuse to install with a Node version outside package.json "engines".
engine-strict=true
